                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center items-center">
                    <div>
                        <p class="font-cinzel text-xs uppercase tracking-widest text-marigold font-bold">Date</p>
                        <p id="display-date" class="font-playfair font-bold text-xl sm:text-2xl text-deepMaroon mt-1">
                            14th December 2026
                        </p>
                        <p id="display-day" class="font-garamond italic text-base text-royalMaroon">
