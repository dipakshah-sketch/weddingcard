                        </p>
                    </div>

                    <div class="sm:border-x border-royalGold/40 px-2">
                        <p class="font-cinzel text-xs uppercase tracking-widest text-marigold font-bold">Muhurat &amp; Time</p>
                        <p id="display-time" class="font-playfair font-bold text-xl sm:text-2xl text-deepMaroon mt-1">
                            7:30 PM Onwards
                        </p>
                        <p class="font-garamond italic text-base text-royalMaroon">
                            Baraat &amp; Varmala
                        </p>
                    </div>

                    <div>
                        <p class="font-cinzel text-xs uppercase tracking-widest text-marigold font-bold">Royal Venue</p>
                        <p id="display-venue" class="font-playfair font-bold text-xl sm:text-2xl text-deepMaroon mt-1">
                            The Royal Palace Lawn
                        </p>
                        <p id="display-city" class="font-garamond italic text-base text-royalMaroon">
                            Grand Heritage Avenue
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ===================================================================== -->
        <!-- 3. WEDDING FESTIVITIES & EVENTS TIMELINE                              -->
        <!-- ===================================================================== -->
        <section class="mt-14 reveal-up">
            <div class="text-center mb-10">
                <p class="font-cinzel text-xs tracking-[0.3em] text-marigold uppercase font-bold">
                    Celebrations &amp; Rituals
                </p>
                <h2 class="font-cinzel text-3xl sm:text-4xl font-bold text-royalMaroon mt-1">
                    Wedding Festivities
                </h2>
                <div class="w-24 h-1 bg-gradient-to-r from-transparent via-royalGold to-transparent mx-auto mt-3"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Event 1: Haldi -->
                <div class="bg-royalCream border-2 border-royalGold/50 rounded-2xl p-6 shadow-lg hover:shadow-xl hover:border-royalGold transition-all relative overflow-hidden group">
                    <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-marigold/10 group-hover:scale-125 transition-transform"></div>
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-xl bg-marigold/15 border border-marigold/40 flex items-center justify-center text-2xl shrink-0">
