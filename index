                </div>

                <!-- Right Peacock SVG (Mirrored) -->
                <div class="hidden md:flex md:col-span-2 justify-center">
                    <svg class="w-20 h-24 transform -scale-x-100" viewBox="0 0 80 100" fill="none">
                        <circle cx="25" cy="45" r="18" fill="#184E59" opacity="0.2"/>
                        <circle cx="20" cy="35" r="5" fill="#184E59"/><circle cx="20" cy="35" r="2" fill="#E8C55A"/>
                        <circle cx="14" cy="48" r="5" fill="#184E59"/><circle cx="14" cy="48" r="2" fill="#E8C55A"/>
                        <circle cx="22" cy="60" r="5" fill="#184E59"/><circle cx="22" cy="60" r="2" fill="#E8C55A"/>
                        <path d="M45 30 C52 30, 52 45, 48 55 C55 62, 52 75, 40 78 C32 78, 35 62, 42 52 C40 42, 40 30, 45 30 Z" fill="#184E59"/>
                        <path d="M48 32 L55 34 L48 36 Z" fill="#E66C1F"/>
                        <line x1="44" y1="30" x2="42" y2="23" stroke="#C59B27" stroke-width="1.2"/>
                        <circle cx="42" cy="22" r="1.5" fill="#6B141A"/>
                    </svg>
                </div>
            </div>

            <!-- Customizable Date, Time & Venue Box -->
            <div class="mt-8 bg-royalPaper/90 border border-royalGold/60 rounded-2xl p-6 sm:p-8 max-w-2xl mx-auto shadow-inner">
                <div class="flex items-center justify-between mb-4 border-b border-royalGold/30 pb-2">
                    <span class="font-cinzel text-xs uppercase tracking-widest text-royalMaroon font-bold">
                        Save The Auspicious Date
                    </span>
                    <button onclick="toggleCustomizeModal()" class="text-xs font-cinzel text-darkGold hover:text-royalMaroon underline flex items-center gap-1 cursor-pointer">
