<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wedding Invitation | Rambabau & Sweat</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Cinzel, Playfair Display, Great Vibes, and Cormorant Garamond -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        royalCream: '#FCF7ED',
                        royalPaper: '#F7EFE0',
                        royalMaroon: '#6B141A',
                        deepMaroon: '#470B10',
                        royalGold: '#C59B27',
                        brightGold: '#E8C55A',
                        darkGold: '#967114',
                        marigold: '#E66C1F',
                        peacockBlue: '#184E59'
                    },
                    fontFamily: {
                        cinzel: ['Cinzel', 'serif'],
                        playfair: ['Playfair Display', 'serif'],
                        script: ['Great Vibes', 'cursive'],
                        garamond: ['Cormorant Garamond', 'serif']
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Royal Ornamentation, Shimmer & Animations */
        body {
            background-color: #FCF7ED;
            color: #470B10;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Metallic Gold Foil Text Effect */
        .gold-foil {
            background: linear-gradient(135deg, #967114 0%, #DFB74C 25%, #FFF2B2 50%, #C59B27 75%, #8A640D 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0px 2px 10px rgba(197, 155, 39, 0.18);
        }

        .gold-foil-bg {
            background: linear-gradient(135deg, #8A640D 0%, #D4AF37 45%, #F3D97E 55%, #AA8018 100%);
        }

        /* Ornate Double Border Card Frame */
        .royal-frame {
            border: 2px solid #C59B27;
            box-shadow: 
                inset 0 0 0 6px #FCF7ED,
                inset 0 0 0 8px #6B141A,
                inset 0 0 0 12px #FCF7ED,
                inset 0 0 0 13px rgba(197, 155, 39, 0.5),
                0 20px 50px rgba(71, 11, 16, 0.15);
            position: relative;
        }

        /* Mandala Slow Rotation */
        @keyframes spinSlow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-slow {
            animation: spinSlow 45s linear infinite;
        }

        /* Gentle Pulse for Wax Seal */
        @keyframes sealPulse {
            0%, 100% { transform: scale(1); box-shadow: 0 0 25px rgba(197, 155, 39, 0.6); }
            50% { transform: scale(1.06); box-shadow: 0 0 40px rgba(232, 197, 90, 0.9); }
        }
        .wax-seal {
            animation: sealPulse 2.8s ease-in-out infinite;
        }

        /* Curtain / Envelope Overlay Transition */
        #invitation-overlay {
            transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1), opacity 1s ease;
        }
        #invitation-overlay.opened {
            transform: translateY(-100%);
            opacity: 0;
            pointer-events: none;
        }

        /* Fade Up Reveal */
        .reveal-up {
            opacity: 0;
            transform: translateY(28px);
            transition: all 0.9s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .reveal-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Subtle Damask Background Pattern */
        .bg-royal-pattern {
            background-image: radial-gradient(rgba(197, 155, 39, 0.14) 1px, transparent 1px),
                              radial-gradient(rgba(107, 20, 26, 0.06) 1px, #FCF7ED 1px);
            background-size: 32px 32px;
            background-position: 0 0, 16px 16px;
        }

        /* Floating Petals Canvas */
        #petals-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 40;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F7EFE0;
        }
        ::-webkit-scrollbar-thumb {
            background: #C59B27;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-royal-pattern font-garamond selection:bg-royalMaroon selection:text-royalCream">

    <!-- Floating Marigold & Rose Petals Canvas -->
    <canvas id="petals-canvas"></canvas>

    <!-- Toast Notification Banner (No alert() used) -->
    <div id="toast-box" class="fixed top-5 left-1/2 -translate-x-1/2 z-[100] hidden transition-all duration-300">
        <div class="bg-deepMaroon text-royalCream border-2 border-royalGold px-6 py-3 rounded-full shadow-2xl flex items-center gap-3 font-cinzel text-sm tracking-wider">
            <span class="text-brightGold text-lg">✦</span>
            <span id="toast-message">Notification</span>
        </div>
    </div>

    <!-- Floating Music & Share Controls -->
    <div class="fixed bottom-5 right-5 z-50 flex flex-col sm:flex-row items-end sm:items-center gap-3">
        <!-- Share Link Button -->
        <button id="share-btn" onclick="copyInviteLink()" class="bg-royalCream/95 backdrop-blur-md text-royalMaroon border-2 border-royalGold hover:bg-royalMaroon hover:text-royalCream transition-all duration-300 px-4 py-3 rounded-full shadow-xl flex items-center gap-2 font-cinzel text-xs font-semibold tracking-wider cursor-pointer" title="Copy Invitation Link">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
