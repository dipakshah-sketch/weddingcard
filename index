                        <div class="w-12 h-12 rounded-xl bg-royalMaroon/10 border border-royalMaroon/30 flex items-center justify-center text-2xl shrink-0">
                            🎶
                        </div>
                        <div>
                            <span class="font-cinzel text-xs font-bold tracking-wider text-royalMaroon uppercase">
                                Musical Evening
                            </span>
                            <h3 class="font-cinzel text-xl font-bold text-deepMaroon">
                                Royal Sangeet Night
                            </h3>
