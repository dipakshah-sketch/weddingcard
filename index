            <span>Share Card</span>
        </button>

        <!-- Music Toggle Button -->
        <button id="music-toggle-btn" onclick="toggleMusic()" class="gold-foil-bg text-deepMaroon border-2 border-royalCream px-4 py-3 rounded-full shadow-2xl flex items-center gap-2 font-cinzel text-xs font-bold tracking-wider hover:scale-105 transition-transform cursor-pointer" title="Play / Mute Wedding Music">
            <span id="music-icon-playing" class="hidden flex items-center gap-1.5">
                <svg class="w-4 h-4 animate-pulse" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                </svg>
                <span>Music On</span>
            </span>
            <span id="music-icon-muted" class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                </svg>
                <span>Play Music</span>
            </span>
        </button>
    </div>

    <!-- ===================================================================== -->
    <!-- 1. LUXURY ENVELOPE / CURTAIN HERO OVERLAY                             -->
    <!-- ===================================================================== -->
    <div id="invitation-overlay" class="fixed inset-0 z-50 bg-gradient-to-b from-deepMaroon via-royalMaroon to-deepMaroon flex flex-col items-center justify-center p-6 text-center overflow-hidden">
        <!-- Decorative Rotating Background Mandala -->
        <svg class="w-[520px] h-[520px] sm:w-[700px] sm:h-[700px] text-royalGold/15 animate-spin-slow absolute pointer-events-none" viewBox="0 0 200 200" fill="none">
            <circle cx="100" cy="100" r="95" stroke="currentColor" stroke-width="0.6" stroke-dasharray="3 3"/>
            <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="0.8"/>
            <circle cx="100" cy="100" r="62" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2"/>
            <path d="M100 5 L112 45 L150 25 L130 63 L175 75 L138 100 L175 125 L130 137 L150 175 L112 155 L100 195 L88 155 L50 175 L70 137 L25 125 L62 100 L25 75 L70 63 L50 25 L88 45 Z" stroke="currentColor" stroke-width="0.6"/>
            <path d="M100 20 Q120 60 160 50 Q135 85 180 100 Q135 115 160 150 Q120 140 100 180 Q80 140 40 150 Q65 115 20 100 Q65 85 40 50 Q80 60 100 20 Z" stroke="currentColor" stroke-width="0.6"/>
        </svg>

        <!-- Inner Gold Border Frame -->
        <div class="relative z-10 max-w-lg w-full border-2 border-royalGold/60 rounded-3xl p-8 sm:p-12 bg-deepMaroon/75 backdrop-blur-sm shadow-2xl">
            <p class="font-cinzel text-brightGold tracking-[0.3em] text-xs sm:text-sm uppercase mb-3">
                ॥ श्री गणेशाय नमः ॥
            </p>
            <p class="font-playfair italic text-royalCream/90 text-base sm:text-lg mb-4">
                You are cordially invited to the royal wedding celebration of
            </p>

            <h1 class="font-cinzel text-4xl sm:text-5xl font-bold gold-foil tracking-wide leading-tight">
                Rambabau
            </h1>
            <div class="font-script text-3xl sm:text-4xl text-brightGold my-1">&amp;</div>
            <h1 class="font-cinzel text-4xl sm:text-5xl font-bold gold-foil tracking-wide leading-tight mb-8">
                Sweat
            </h1>

            <!-- Interactive Royal Wax Seal Button -->
            <button onclick="openInvitation()" class="wax-seal group relative mx-auto w-28 h-28 sm:w-32 sm:h-32 rounded-full gold-foil-bg border-4 border-royalCream flex flex-col items-center justify-center text-deepMaroon cursor-pointer transition-transform hover:scale-110 focus:outline-none">
                <span class="font-cinzel font-extrabold text-xl sm:text-2xl tracking-widest">R &amp; S</span>
                <span class="font-cinzel text-[10px] sm:text-xs font-bold uppercase tracking-wider mt-1 border-t border-deepMaroon/40 pt-1">
                    Open Card
                </span>
            </button>

            <p class="font-garamond text-royalCream/80 text-sm sm:text-base mt-6 tracking-wide">
                Tap the royal seal to unveil invitation &amp; start celebratory music
            </p>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 2. MAIN WEDDING INVITATION CARD & WEBSITE CONTENT                     -->
    <!-- ===================================================================== -->
    <main class="max-w-4xl mx-auto px-4 sm:px-8 py-10 sm:py-16 relative z-10">

        <!-- HERO / MAIN INVITATION CARD -->
        <section class="royal-frame bg-royalCream rounded-3xl p-6 sm:p-14 text-center shadow-2xl reveal-up">
            
            <!-- Top Marigold Garland & Floral SVG Banner -->
            <div class="flex justify-center mb-4">
                <svg class="w-full max-w-md h-16" viewBox="0 0 400 70" fill="none">
                    <!-- Hanging Marigold Garlands -->
