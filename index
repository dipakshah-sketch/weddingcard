    <!-- ===================================================================== -->
    <!-- JAVASCRIPT: WEB AUDIO CELEBRATORY MUSIC, PETALS & INTERACTIVITY       -->
    <!-- ===================================================================== -->
    <script>
        /* -------------------------------------------------------------------
         * 1. BUILT-IN CELEBRATORY INDIAN WEDDING MELODY (WEB AUDIO API)
         * Plays a soothing, festive Raga Yaman / Kalyaani inspired santoor &
         * temple chime melody with warm tanpura drone—zero external MP3s needed!
         * ------------------------------------------------------------------- */
        let audioCtx = null;
        let isPlayingMusic = false;
        let melodyInterval = null;
        let droneOsc1 = null;
        let droneOsc2 = null;
        let droneGain = null;

        // Raga Yaman / Festive Indian Wedding Pentatonic-Lydian scale frequencies (Hz)
        // Sa (C4), Re (D4), Ga (E4), Ma# (F#4), Pa (G4), Dha (A4), Ni (B4), Sa' (C5), Re' (D5), Ga' (E5)
        const ragaNotes = [
            261.63, // Sa
            293.66, // Re
            329.63, // Ga
            369.99, // Ma#
            392.00, // Pa
            440.00, // Dha
            493.88, // Ni
            523.25, // Sa'
            587.33, // Re'
            659.25  // Ga'
        ];

        // Traditional celebratory wedding melody sequence (indices into ragaNotes)
        const weddingPhrase = [
            4, 6, 7, 9, 8, 7, 6, 4,
            2, 4, 6, 7, 6, 4, 2, 0,
            1, 2, 4, 6, 7, 6, 4, 2,
            4, 3, 2, 1, 0, 2, 1, 0
        ];
        let noteStep = 0;

        function initAudioEngine() {
            if (!audioCtx) {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContextClass();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function startTanpuraDrone() {
            if (!audioCtx || droneOsc1) return;
            droneGain = audioCtx.createGain();
            droneGain.gain.setValueAtTime(0.001, audioCtx.currentTime);
            droneGain.gain.exponentialRampToValueAtTime(0.035, audioCtx.currentTime + 2.0);
            droneGain.connect(audioCtx.destination);

            // Sa (C3 = 130.81Hz) and Pa (G3 = 196.00Hz) warm ambient harmonic drone
            droneOsc1 = audioCtx.createOscillator();
            droneOsc1.type = 'sine';
            droneOsc1.frequency.setValueAtTime(130.81, audioCtx.currentTime);

            droneOsc2 = audioCtx.createOscillator();
            droneOsc2.type = 'triangle';
            droneOsc2.frequency.setValueAtTime(196.00, audioCtx.currentTime);

            const filter = audioCtx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(320, audioCtx.currentTime);

            droneOsc1.connect(filter);
            droneOsc2.connect(filter);
            filter.connect(droneGain);

            droneOsc1.start();
            droneOsc2.start();
        }

        function stopTanpuraDrone() {
            if (droneOsc1) {
                try {
                    droneOsc1.stop();
                    droneOsc2.stop();
                } catch (e) {}
                droneOsc1 = null;
                droneOsc2 = null;
            }
        }

        function playSantoorChime(freq) {
            if (!audioCtx || !isPlayingMusic) return;
            const now = audioCtx.currentTime;

            // Primary plucked string / bell tone
            const osc = audioCtx.createOscillator();
            const overtone = audioCtx.createOscillator();
            const gain = audioCtx.createGain();

            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now);

            // Octave shimmer for santoor/chime sparkle
            overtone.type = 'triangle';
            overtone.frequency.setValueAtTime(freq * 2, now);

            const overtoneGain = audioCtx.createGain();
            overtoneGain.gain.setValueAtTime(0.025, now);
            overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.9);

            gain.gain.setValueAtTime(0.001, now);
            gain.gain.linearRampToValueAtTime(0.09, now + 0.04);
            gain.gain.exponentialRampToValueAtTime(0.0008, now + 1.8);

            osc.connect(gain);
            overtone.connect(overtoneGain);
            overtoneGain.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start(now);
            overtone.start(now);
            osc.stop(now + 1.9);
            overtone.stop(now + 1.9);
        }

        function startMusic() {
            try {
                initAudioEngine();
                if (isPlayingMusic) return;
                isPlayingMusic = true;
                updateMusicButtonUI();
                startTanpuraDrone();

                // Play first note immediately
                playSantoorChime(ragaNotes[weddingPhrase[noteStep % weddingPhrase.length]]);
                noteStep++;

                melodyInterval = setInterval(() => {
                    if (!isPlayingMusic) return;
                    const freq = ragaNotes[weddingPhrase[noteStep % weddingPhrase.length]];
                    playSantoorChime(freq);
                    noteStep++;
                }, 620);
            } catch (err) {
                console.warn('Audio playback prevented until user gesture:', err);
            }
        }

        function stopMusic() {
            isPlayingMusic = false;
            updateMusicButtonUI();
            if (melodyInterval) {
                clearInterval(melodyInterval);
                melodyInterval = null;
            }
            stopTanpuraDrone();
        }

        function toggleMusic() {
            if (isPlayingMusic) {
                stopMusic();
                showToast('Celebratory music muted');
            } else {
                startMusic();
                showToast('Playing royal wedding melody 🎶');
            }
        }

        function updateMusicButtonUI() {
            const playingEl = document.getElementById('music-icon-playing');
            const mutedEl = document.getElementById('music-icon-muted');
            if (isPlayingMusic) {
                playingEl.classList.remove('hidden');
                mutedEl.classList.add('hidden');
            } else {
                playingEl.classList.add('hidden');
                mutedEl.classList.remove('hidden');
            }
        }

        /* -------------------------------------------------------------------
         * 2. ENVELOPE / CURTAIN REVEAL & SCROLL ANIMATIONS
         * ------------------------------------------------------------------- */
        function openInvitation() {
            const overlay = document.getElementById('invitation-overlay');
            overlay.classList.add('opened');
            startMusic();
            triggerScrollReveals();
        }

        function triggerScrollReveals() {
            const reveals = document.querySelectorAll('.reveal-up');
            reveals.forEach((el, idx) => {
                setTimeout(() => {
                    el.classList.add('visible');
                }, idx * 180);
            });
        }

        window.addEventListener('scroll', () => {
            const reveals = document.querySelectorAll('.reveal-up');
            reveals.forEach(el => {
                const top = el.getBoundingClientRect().top;
                if (top < window.innerHeight - 60) {
                    el.classList.add('visible');
                }
            });
        });

        /* -------------------------------------------------------------------
         * 3. RSVP & LIVE BLESSINGS WALL HANDLER
         * ------------------------------------------------------------------- */
        let wishCount = 3;

        function handleRsvpSubmit(event) {
            event.preventDefault();
            const nameInput = document.getElementById('guest-name');
            const attendanceSelect = document.getElementById('attendance');
            const blessingInput = document.getElementById('guest-blessing');

            const name = nameInput.value.trim();
            const status = attendanceSelect.value;
            const blessing = blessingInput.value.trim();

            if (!name || !blessing) return;

            const list = document.getElementById('blessings-list');
            const card = document.createElement('div');
            card.className = 'bg-royalCream border-2 border-royalGold rounded-2xl p-4 shadow-md transition-all duration-500';

            const badgeEmoji = status.includes('Family') ? '👨‍👩‍👧‍👦' : (status.includes('Afar') ? '💐' : '✨');

            const header = document.createElement('div');
            header.className = 'flex items-center justify-between gap-2 mb-1';

            const title = document.createElement('h4');
            title.className = 'font-cinzel font-bold text-sm text-royalMaroon';
            title.textContent = name;

            const badge = document.createElement('span');
            badge.className = 'text-xs font-cinzel bg-marigold/15 text-marigold px-2.5 py-0.5 rounded-full font-semibold';
            badge.textContent = `${badgeEmoji} ${status}`;

            header.appendChild(title);
            header.appendChild(badge);

            const body = document.createElement('p');
            body.className = 'font-playfair italic text-deepMaroon text-base';
            body.textContent = `“${blessing}”`;

            card.appendChild(header);
            card.appendChild(body);

            list.prepend(card);

            wishCount++;
            document.getElementById('blessing-count').textContent = `${wishCount} Wishes`;

            nameInput.value = '';
            blessingInput.value = '';

            showToast(`Thank you, ${name}! Your blessing has been added.`);
        }

        /* -------------------------------------------------------------------
         * 4. SHARE LINK & CUSTOMIZE MODAL HELPERS
         * ------------------------------------------------------------------- */
        function copyInviteLink() {
            const url = window.location.href;
            const tempInput = document.createElement('input');
            tempInput.value = url;
            document.body.appendChild(tempInput);
            tempInput.select();
            try {
                document.execCommand('copy');
                showToast('Invitation link copied! Ready to share with guests.');
            } catch (e) {
                showToast('Share this page URL directly with your guests!');
            }
            document.body.removeChild(tempInput);
        }

        function toggleCustomizeModal() {
            const modal = document.getElementById('customize-modal');
            modal.classList.toggle('hidden');
            modal.classList.toggle('flex');
        }

        function saveEventDetails() {
            document.getElementById('display-date').textContent = document.getElementById('input-date').value || '14th December 2026';
            document.getElementById('display-day').textContent = document.getElementById('input-day').value || 'Monday';
            document.getElementById('display-time').textContent = document.getElementById('input-time').value || '7:30 PM Onwards';
            document.getElementById('display-venue').textContent = document.getElementById('input-venue').value || 'The Royal Palace Lawn';
            document.getElementById('display-city').textContent = document.getElementById('input-city').value || 'Grand Heritage Avenue';
            toggleCustomizeModal();
            showToast('Wedding card details updated!');
        }

        function showToast(msg) {
            const box = document.getElementById('toast-box');
            const text = document.getElementById('toast-message');
            text.textContent = msg;
            box.classList.remove('hidden');
            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => {
                box.classList.add('hidden');
            }, 3400);
        }

        /* -------------------------------------------------------------------
         * 5. FLOATING MARIGOLD & ROSE PETALS PARTICLE ANIMATION
         * ------------------------------------------------------------------- */
        const canvas = document.getElementById('petals-canvas');
        const ctx = canvas.getContext('2d');
        let petals = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        const petalColors = [
            'rgba(230, 108, 31, 0.45)',  // Marigold orange
            'rgba(232, 197, 90, 0.50)',  // Royal gold
            'rgba(107, 20, 26, 0.35)',   // Deep rose maroon
            'rgba(245, 158, 11, 0.45)'   // Saffron yellow
        ];

        class Petal {
            constructor() {
                this.reset(true);
            }
            reset(initial = false) {
                this.x = Math.random() * canvas.width;
                this.y = initial ? Math.random() * canvas.height : -20;
                this.size = 5 + Math.random() * 7;
                this.speedY = 0.6 + Math.random() * 1.1;
                this.speedX = (Math.random() - 0.5) * 0.8;
                this.angle = Math.random() * Math.PI * 2;
                this.spin = (Math.random() - 0.5) * 0.03;
                this.color = petalColors[Math.floor(Math.random() * petalColors.length)];
            }
            update() {
                this.y += this.speedY;
                this.x += this.speedX + Math.sin(this.angle) * 0.35;
                this.angle += this.spin;
                if (this.y > canvas.height + 20) {
                    this.reset(false);
                }
            }
            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.angle);
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.ellipse(0, 0, this.size, this.size * 0.55, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        function initPetals() {
            const count = window.innerWidth < 640 ? 22 : 38;
            petals = Array.from({ length: count }, () => new Petal());
        }

        function animatePetals() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            petals.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animatePetals);
        }

        window.onload = function () {
            initPetals();
            animatePetals();
        };
    </script>
