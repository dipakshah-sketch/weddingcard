                    <path d="M50 5 Q125 42 200 15 Q275 42 350 5" stroke="#6B141A" stroke-width="1"/>
                    <!-- Marigold Blossoms -->
                    <circle cx="110" cy="30" r="8" fill="#E66C1F"/>
                    <circle cx="110" cy="30" r="4" fill="#F3D97E"/>
                    <circle cx="290" cy="30" r="8" fill="#E66C1F"/>
                    <circle cx="290" cy="30" r="4" fill="#F3D97E"/>
                    <circle cx="65" cy="21" r="6" fill="#6B141A"/>
                    <circle cx="335" cy="21" r="6" fill="#6B141A"/>
                    <circle cx="155" cy="26" r="6" fill="#C59B27"/>
                    <circle cx="245" cy="26" r="6" fill="#C59B27"/>
                    <!-- Center Royal Lotus / Kalash Emblem -->
                    <path d="M200 6 C206 16, 214 22, 200 32 C186 22, 194 16, 200 6 Z" fill="#6B141A"/>
                    <path d="M200 12 C212 18, 220 26, 200 34 C180 26, 188 18, 200 12 Z" fill="#E66C1F" opacity="0.85"/>
                    <circle cx="200" cy="36" r="4" fill="#C59B27"/>
                </svg>
            </div>

            <!-- Sacred Invocation -->
            <p class="font-cinzel text-royalMaroon font-semibold tracking-[0.25em] text-xs sm:text-sm uppercase mb-2">
                With the Heavenly Blessings of Almighty &amp; Elders
            </p>

            <!-- Ornate Heading -->
            <h2 class="font-playfair italic text-royalGold text-2xl sm:text-3xl mb-1">
                Royal Wedding Invitation
            </h2>

            <!-- Divider Flourish -->
            <div class="flex items-center justify-center gap-3 my-4">
                <span class="h-[1px] w-16 sm:w-28 bg-gradient-to-r from-transparent to-royalGold"></span>
                <span class="text-royalMaroon text-lg">❖</span>
                <span class="h-[1px] w-16 sm:w-28 bg-gradient-to-l from-transparent to-royalGold"></span>
            </div>

            <!-- Couple Names Display -->
            <div class="my-6 sm:my-8">
                <h1 class="font-cinzel text-5xl sm:text-7xl font-extrabold gold-foil tracking-wider">
                    Rambabau
                </h1>
                <div class="font-script text-4xl sm:text-6xl text-royalMaroon my-2">
                    &amp;
                </div>
                <h1 class="font-cinzel text-5xl sm:text-7xl font-extrabold gold-foil tracking-wider">
                    Sweat
                </h1>
            </div>

            <!-- Decorative Peacock Motifs Flanking Heartfelt Verse -->
            <div class="grid grid-cols-1 md:grid-cols-12 items-center gap-4 my-6">
                <!-- Left Peacock SVG -->
                <div class="hidden md:flex md:col-span-2 justify-center">
                    <svg class="w-20 h-24" viewBox="0 0 80 100" fill="none">
                        <!-- Peacock Tail Plumes -->
                        <circle cx="25" cy="45" r="18" fill="#184E59" opacity="0.2"/>
